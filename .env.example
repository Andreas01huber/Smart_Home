# Vorlage. Kopiere sie nach .env und trage deine Werte ein.
# .env ist in .gitignore ausgeschlossen (Anforderung 4H / 4T).
#
# WICHTIG: Hier gehören KEINE Passwörter hinein — nur Tokens.

# --- Victron VRM ---------------------------------------------------------
# Access Token aus dem VRM-Portal:
#   VRM Portal -> oben rechts auf deinen Namen -> Preferences -> Integrations
#   -> Access tokens -> "Add token"
# Der Token wird genau EINMAL angezeigt und ist danach nicht mehr abrufbar.
# Verwendet wird er als HTTP-Header: x-authorization: Token <wert>
VRM_ACCESS_TOKEN=

# --- Fronius -------------------------------------------------------------
# Optional. Wenn leer, sucht das Discovery-Tool das lokale Netz selbst ab.
# Die lokale Fronius Solar API benötigt keine Zugangsdaten.
FRONIUS_HOST=

# --- Victron GX (lokal) --------------------------------------------------
# Optional. Wenn leer, sucht das Discovery-Tool das lokale Netz selbst ab.
VICTRON_GX_HOST=
# VRM Portal ID des GX-Geräts (GX -> Einstellungen -> VRM Online Portal).
# Nur nötig, falls die automatische Erkennung über MQTT nichts findet.
VICTRON_PORTAL_ID=
